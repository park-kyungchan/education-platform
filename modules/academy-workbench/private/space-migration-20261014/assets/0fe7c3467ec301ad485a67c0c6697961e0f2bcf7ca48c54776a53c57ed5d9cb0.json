      ],
      "stages": [
        {
          "id": "assignment",
          "action": "DaysMain에서 대상 학생의 날짜별 최신 배정 과제와 원문 범위를 읽는다.",
          "guard": "과제 날짜와 학생 및 과정이 맞는지 확인하고 이전 과제를 현재 과제로 바꾸지 않는다."
        },
        {
          "id": "course-and-section",
          "action": "StudyCourse와 실제 교재 또는 헤더 근거로 교재 버전 및 섹션과 범위를 연결한다.",
          "guard": "같은 교재의 복수 버전과 동시 등록 과정을 구분한다. 문제 섹션만 등록하고 영상은 별도 경로로 둔다."
        },
        {
          "id": "requirements",
          "action": "같은 Assignment 아래 예습 영상 요구와 문제 섹션별 풀이·입력·채점 요구를 별개로 만든다.",
          "guard": "종이 전용 예외가 명시된 과제만 앱 입력과 집 채점 요구를 제외한다. 일반 오답 정리에는 자동 적용하지 않는다."
        },
        {
          "id": "video-evidence",
          "action": "TeacherPrestudySummary와 WebUnPreStudy 및 WebCtPreStudy에서 대상 범위의 영상과 관련 표시를 읽는다.",
          "guard": "영상의 단원과 버전은 영상 경로에서 확인하며 교재 버전과 임의로 일치시키지 않는다. 영상 OK와 교사 검사 표시 및 QR 도움 가능성을 구분한다."
        },
        {
          "id": "grading-evidence",
          "action": "TestPageList의 StudentNameSearch에서 같은 과제의 과정, 섹션, 범위와 시도 및 채점 기록을 읽는다.",
          "guard": "검색창만 보지 않고 결과 행의 학생을 확인한다. 비동기 이전 학생 표와 적용되지 않은 필터는 증거에서 버린다."
        },
        {
          "id": "scope-match",
          "action": "각 AssignmentScopeItem에 채점 시도와 관찰을 연결하고 범위 전체, 일부, 불일치 및 미확인을 나눈다.",
          "guard": "이전 점수와 일부 단원 채점을 새 숙제 전체 완료로 사용하지 않는다. 페이지나 문항 대응이 불명확하면 ambiguous_mapping으로 둔다."
        },
        {
          "id": "teacher-judgment",
          "action": "확인한 사실과 예외 및 아직 확인하지 못한 항목을 보고하고 사용자 판단이 제공되면 별도 연결한다.",
          "guard": "앱 기록만으로 종이 풀이를 확정하거나 마감 전 미관찰을 실패로 선언하지 않는다."
        },
        {
          "id": "pdf-basis",
          "action": "향후 허용된 오답 및 유사문항 생성에 해당 범위와 채점 시도 및 원래 오답 문항의 근거를 제공한다.",
          "guard": "원래 문항과 유사문항의 출처 시도를 보존한다. 출처 선택이 모호하면 생성하지 않으며 현재 지속 자동 생성과 인쇄는 승인되지 않았다."
        }
      ],
