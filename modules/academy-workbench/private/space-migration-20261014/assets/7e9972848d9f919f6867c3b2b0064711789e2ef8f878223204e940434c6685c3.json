{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:academy:student-refresh:schema:1.0.1",
  "$defs": {
    "PerStudentRefreshPlan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "studentId": {
          "type": "string",
          "minLength": 1
        },
        "rosterRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "sourcePlans": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "readPathContractId": {
                "type": "string",
                "minLength": 1
              },
              "requestedWindow": {
                "type": "string",
                "minLength": 1
              },
              "requiredFields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "freshnessPolicy": {
                "type": "string",
                "minLength": 1
              },
              "expectedIdentityMatch": {
                "type": "string",
                "const": "student_and_result_rows"
              },
              "cacheKeyFields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "sourceId",
              "readPathContractId",
              "requestedWindow",
              "requiredFields",
              "freshnessPolicy",
              "expectedIdentityMatch",
              "cacheKeyFields"
            ],
            "additionalProperties": false
          }
        },
        "authorizationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "noOverlapKey": {
          "type": "string",
          "minLength": 1
        },
        "checkpointRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "requestState": {
          "type": "string",
          "enum": [
            "planned",
            "accepted",
            "running",
            "completed",
            "partial",
            "failed"
          ]
        },
        "continuousConnectionRequired": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "id",
        "version",
        "studentId",
        "rosterRevision",
        "purpose",
        "sourcePlans",
        "authorizationRefs",
        "idempotencyKey",
        "noOverlapKey",
        "checkpointRef",
        "requestedAt",
        "requestState",
        "continuousConnectionRequired"
      ],
      "additionalProperties": false
    },
    "PerStudentRefreshRun": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "planId": {
          "type": "string",
          "minLength": 1
        },
        "planVersion": {
          "type": "string",
          "minLength": 1
        },
        "studentId": {
          "type": "string",
          "minLength": 1
        },
        "requestAcceptedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "endedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "running",
            "partial",
            "verified",
            "failed"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "readPathContractId": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "querying",
                  "verified",
                  "partial",
                  "failed",
                  "inaccessible",
                  "stale_result_rejected"
                ]
              },
              "queriedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "eventAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "previousLastSuccessAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lastSuccessAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "identityMatch": {
                "type": "string",
                "enum": [
                  "verified",
                  "mismatch",
                  "not_checked"
                ]
              },
              "queryCompleted": {
                "type": "boolean"
              },
              "coverage": {
                "type": "object",
                "properties": {
                  "requestedWindow": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observedWindow": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "pageCursor": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceExhausted": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "completeness": {
                    "type": "string",
                    "enum": [
                      "bounded_verified",
                      "partial",
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "requestedWindow",
                  "observedWindow",
                  "pageCursor",
                  "sourceExhausted",
                  "completeness"
                ],
                "additionalProperties": false
              },
              "cacheValidation": {
                "type": "string",
                "enum": [
                  "verified_hit",
                  "miss",
                  "invalidated",
                  "not_checked"
                ]
              },
              "sourceSnapshotHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "previousSnapshotHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "publicationReadbackVerified": {
                "type": "boolean"
              },
              "preservePrevious": {
                "type": "boolean"
              },
              "latencyMs": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "batchId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "checkpointRef": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "failureReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sourceId",
              "readPathContractId",
              "status",
              "queriedAt",
              "eventAt",
              "previousLastSuccessAt",
              "lastSuccessAt",
              "identityMatch",
              "queryCompleted",
              "coverage",
              "cacheValidation",
              "sourceSnapshotHash",
              "previousSnapshotHash",
              "publicationReadbackVerified",
              "preservePrevious",
              "latencyMs",
              "batchId",
              "checkpointRef",
              "failureReason"
            ],
            "additionalProperties": false
          }
        },
        "noOverlapVerified": {
          "type": "boolean"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "checkpointRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "totalLatencyMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "scopeFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "authorityEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "eventLog": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "actionVersion": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "targetSnapshot": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "entityType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "domain": {
                      "type": "string",
                      "enum": [
                        "academy",
                        "math",
                        "common"
                      ]
                    }
                  },
                  "required": [
                    "entityType",
                    "id",
                    "revision",
                    "domain"
                  ],
                  "additionalProperties": false
                }
              },
              "preconditionsChecked": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "authorityRef": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "idempotencyKey": {
                "type": "string",
                "minLength": 1
              },
              "startedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "endedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "planned",
                  "blocked",
                  "executed_unknown",
                  "verified_success",
                  "verified_failure"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sideEffectOutcome": {
                "type": "string",
                "enum": [
                  "not_executed",
                  "verified",
                  "unknown"
                ]
              },
              "supersedes": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "actionId",
              "actionVersion",
              "purpose",
              "targetSnapshot",
              "preconditionsChecked",
              "authorityRef",
              "idempotencyKey",
              "startedAt",
              "endedAt",
              "outcome",
              "evidenceRefs",
              "sideEffectOutcome",
              "supersedes"
            ],
            "additionalProperties": false
          }
        },
        "runtimeImplementation": {
          "type": "string",
          "enum": [
            "not_implemented",
            "local_validator_only",
            "verified_in_scope"
          ]
        }
      },
      "required": [
        "id",
        "planId",
        "planVersion",
        "studentId",
        "requestAcceptedAt",
        "startedAt",
        "endedAt",
        "outcome",
        "sources",
        "noOverlapVerified",
        "idempotencyKey",
        "checkpointRef",
        "totalLatencyMs",
        "scopeFingerprint",
        "authorityEvidenceRefs",
        "eventLog",
        "runtimeImplementation"
      ],
      "additionalProperties": false
    },
    "Roster": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "students": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "managedState": {
                "type": "string",
                "enum": [
                  "active",
                  "ended"
                ]
              },
              "confirmationRef": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "managedState",
              "confirmationRef"
            ],
            "additionalProperties": false
          }
        },
        "enrollments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "studentId": {
                "type": "string",
                "minLength": 1
              },
              "classId": {
                "type": "string",
                "minLength": 1
              },
              "validFrom": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "validTo": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "studentId",
              "classId",
              "validFrom",
              "validTo"
            ],
            "additionalProperties": false
          }
        },
        "bookEnrollments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "studentId": {
                "type": "string",
                "minLength": 1
              },
              "editionRef": {
                "type": "string",
                "minLength": 1
              },
              "validFrom": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "validTo": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "studentId",
              "editionRef",
              "validFrom",
              "validTo"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "revision",
        "students",
        "enrollments",
        "bookEnrollments"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PerStudentRefreshPlan"
    },
    {
      "$ref": "#/$defs/PerStudentRefreshRun"
    },
    {
      "$ref": "#/$defs/Roster"
    }
  ]
}
