    {
      "id": "REQ-evidence",
      "text": "근거의 실제 조회 시각, 날짜 범위, 필터 검증과 부분 관측 상태를 보존한다.",
      "status": "user_confirmed",
      "sourceIds": [
        "Sentinel_ebaa6c04bd708191bfeb691439e91b5b"
      ]
