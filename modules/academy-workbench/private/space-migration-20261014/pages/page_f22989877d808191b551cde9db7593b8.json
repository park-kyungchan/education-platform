          "metadata": {}
        },
        {
          "id": "ff0f2a75-5ed9-420a-9ff9-a68fa8146c67",
          "kind": "markdown",
          "markdown": "[academy-environment-manifest.r5.json](library-file:fde1_bGliZmlsZV9wUE1CMDBxQl9tTzRkNWRaSWpSMi13_FileDrive_73e3d24e44d881918a9b9622fd5a4193)",
