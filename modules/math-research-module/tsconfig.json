{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "research",
    "harness",
    "ci"
  ],
  "exclude": [
    "source",
    "node_modules",
    ".harness-deps",
    "dist"
  ]
}
