{
  "name": "@palantirkc/education-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "check": "bun scripts/check.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test ./tests",
    "status": "bun src/cli.ts status",
    "module": "bun src/cli.ts module",
    "verify:imports": "bun scripts/verify-imports.ts",
    "setup": "bun scripts/setup.ts",
    "academy:repositories": "bun --no-env-file scripts/academy-repositories.ts plan",
    "harness:work": "bun --no-env-file scripts/academy-repositories.ts work",
    "context:academy": "bun --no-env-file scripts/academy-context.ts",
    "verify:academy-integration": "bun --no-env-file scripts/verify-academy-integration.ts"
  },
  "dependencies": {
    "@palantirkc/ontology": "file:releases/palantirkc-ontology-0.2.0.tgz"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
