{
  "name": "math-education",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "doctor": "bun scripts/doctor.ts",
    "doctor:cloud": "bun scripts/doctor.ts",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
