            "type": "string"
          }
        },
        "severity": {
          "const": "review"
        },
        "resolution": {
          "enum": [
            "open",
            "resolved"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "schemaVersion",
        "revision",
        "status",
        "sourceIds",
        "updatedAt",
        "canonicalParentId",
        "title",
        "description",
