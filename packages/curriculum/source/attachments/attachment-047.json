{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MathEducation UI sample schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "term"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": "1.1.0"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "prototype",
            "validated"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "canonicalParentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "schemaVersion",
        "revision",
        "status",
        "sourceIds",
        "updatedAt",
        "canonicalParentId",
        "label",
        "meaning"
      ]
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "symbol"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": "1.1.0"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "prototype",
            "validated"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "canonicalParentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "notation": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "schemaVersion",
        "revision",
        "status",
        "sourceIds",
        "updatedAt",
        "canonicalParentId",
        "notation",
        "meaning",
        "scope"
      ]
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "concept"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": "1.1.0"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "prototype",
            "validated"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "canonicalParentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "초5–6",
            "중1",
            "중2",
            "중3"
          ]
        },
        "stageMappingStatus": {
          "const": "proposed_not_standard_mapped"
        },
        "meaning": {
          "type": "string"
        },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/term"
          }
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example": {
          "type": "string"
        },
        "misconception": {
          "type": "string"
        },
        "evidenceStatus": {
          "const": "author_constructed_math_example"
        },
        "achievementStandardIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advancedLens": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "advanced_explanation"
                },
                "audience": {
                  "const": "university"
                },
                "notCurricularPrerequisite": {
                  "const": true
                },
                "statement": {
                  "type": "string"
                },
                "proof": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "audience",
                "notCurricularPrerequisite",
                "statement",
                "proof"
              ]
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "schemaVersion",
        "revision",
        "status",
        "sourceIds",
        "updatedAt",
        "canonicalParentId",
