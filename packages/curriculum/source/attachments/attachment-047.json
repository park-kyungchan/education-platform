          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "prototype",
            "validated"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "canonicalParentId": {
          "type": [
            "string",
