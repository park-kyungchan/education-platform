  "properties": {
    "kind": {
      "const": "math_knowledge_sample"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "prototype",
        "validated"
      ]
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "canonicalParentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "curriculum": {
          "type": "string"
        },
        "grades": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "string"
        },
        "completeness": {
          "const": "12_concept_ui_sample_only"
        },
        "publisherTocRole": {
          "const": "reference_only"
        }
      },
      "required": [
        "curriculum",
        "grades",
        "priority",
        "completeness",
        "publisherTocRole"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "page_binding"
          },
          "id": {
            "type": "string"
          },
          "pageId": {
            "type": "string"
          },
          "canonicalParentId": {
            "type": "string"
          },
          "role": {
            "enum": [
              "project",
              "task",
              "concept_detail"
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "pageId",
          "canonicalParentId",
          "role"
        ]
      }
    },
    "viewContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
