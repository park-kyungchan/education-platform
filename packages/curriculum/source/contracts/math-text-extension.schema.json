{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:matheducation:math-text-extension.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "MathTextAnnotations"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "MathTextField"
          },
          "fieldPath": {
            "type": "string",
            "pattern": "^/(definition|meaning|statement|reasoning|rationale|conditions/[0-9]+/(statement|formalExpression))$"
          },
          "sourceTextSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "classification": {
            "enum": [
              "math_annotated",
              "plain_prose",
              "pending_review"
            ]
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "TextSegment"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "MathSegment"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "markup": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "MathMarkup"
                        },
                        "dialect": {
                          "const": "latex"
                        },
                        "source": {
                          "type": "string",
                          "minLength": 1
                        },
                        "plainTextFallback": {
                          "type": "string"
                        },
                        "displayMode": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "kind",
                        "dialect",
                        "source",
                        "plainTextFallback",
                        "displayMode"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "text",
                    "markup"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "kind",
          "fieldPath",
          "sourceTextSha256",
          "classification",
          "segments"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "fields"
  ],
  "additionalProperties": false
}
