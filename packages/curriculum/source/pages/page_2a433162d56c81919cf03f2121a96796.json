      "metadata": {}
    },
    {
      "id": "3009287a-e4f6-46af-984e-6bcedb29d8cb",
      "kind": "markdown",
      "hash": "39b1835f77bc1cd9b307c945bebc0cea8e57764d54b6e7f73a623390a2c95a4e",
