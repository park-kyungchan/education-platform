      "metadata": {}
    },
    {
      "id": "bd72e38b-3c79-40f0-a95b-30fe0e882ab2",
      "kind": "markdown",
      "hash": "513593f22f03f70bd5f80e44b1ca625cdda0e73b1dd52bf08610f345b5cdb184",
